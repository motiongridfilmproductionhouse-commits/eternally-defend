# ==============================================================================
# Public Frontend Variables (Safe to expose)
# ==============================================================================
# Base URL for the public-facing application
PUBLIC_APP_URL="http://localhost:5173"
# Canonical public origin used to derive worker hook URLs when explicit
# DEEPFAKE_*_WORKER_URL values are not set (also accepts SITE_URL / APP_URL).
SITE_URL="http://localhost:5173"

# ==============================================================================
# Deepfake Intelligence worker dispatch (required to start scans)
# ==============================================================================
# Exact worker hook OR bare origin (hook path is appended automatically).
# DEEPFAKE_SCAN_WORKER_URL="https://your-deployed-origin/api/public/hooks/deepfake-scan-execute"
# DEEPFAKE_GOOGLE_IMAGES_WORKER_URL="https://your-deployed-origin/api/public/hooks/deepfake-google-images-worker"
# Shared HMAC secret — must be present in both the dispatcher and worker runtime.
COPYRIGHT_SCAN_WORKER_SECRET="your_copyright_scan_worker_secret"
# Optional browser Google Images collector
# CRAWLER_SERVICE_URL="https://your-crawler-service"

# ==============================================================================
# Supabase
# ==============================================================================
# Public variables for Supabase (Frontend & Backend)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"

SUPABASE_URL="https://your_supabase_project_id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"

# Secret Supabase Key (Backend Only - Bypass RLS)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Protected Sarayu meeting preload. Keep the six exact Google #sv= URLs here
# (newline-separated or JSON array); fragments are part of the idempotency key.
SARAYU_MOHAN_MANUAL_EVIDENCE_URLS=""
DEEPFAKE_MANUAL_EVIDENCE_WORKER_URL="https://eternally-defend.vercel.app/api/public/hooks/deepfake-manual-evidence-execute"
DEEPFAKE_MANUAL_EVIDENCE_WORKER_SECRET=""

# ==============================================================================
# Account-type onboarding (new accounts only)
# ==============================================================================
# Keep disabled until the migration and rollout checklist are complete.
ACCOUNT_TYPE_ONBOARDING_ENABLED="false"
# Required when enabling. Existing accounts are never reclassified.
ACCOUNT_TYPE_ONBOARDING_ACTIVATION_AT=""

# ==============================================================================
# Firecrawl (Web Scanning API)
# ==============================================================================
# Secret Key for Mendable Firecrawl
FIRECRAWL_API_KEY="your_firecrawl_api_key"

# ==============================================================================
# Google / YouTube / Lovable AI
# ==============================================================================
# Google/YouTube API Key for Video Scanning
GOOGLE_API_KEY="your_google_api_key"
YOUTUBE_API_KEY="your_youtube_api_key"

# Lovable API Key (Gemini extraction / video classification)
LOVABLE_API_KEY="your_lovable_api_key"

# Fact Checking API Key
FACT_CHECK_API_KEY="your_fact_check_api_key"

# Google Cloud Project Configuration (Vision/Translation/Speech)
GOOGLE_CLOUD_PROJECT_ID="your_google_cloud_project_id"
GOOGLE_CLOUD_STORAGE_BUCKET="your_google_cloud_storage_bucket"
GOOGLE_APPLICATION_CREDENTIALS_JSON="your_google_application_credentials_json"

# ==============================================================================
# AWS Rekognition & S3 (Face Protection & Assets)
# ==============================================================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REKOGNITION_BUCKET="your_aws_rekognition_bucket"

# ==============================================================================
# Veriff (KYC / Identity Verification)
# ==============================================================================
VERIFF_API_KEY="your_veriff_api_key"
VERIFF_SHARED_SECRET="your_veriff_shared_secret"
VERIFF_BASE_URL="https://stationapi.veriff.com"

# ==============================================================================
# Account-type onboarding (v2) — new accounts only
# ==============================================================================
# Both must be set for new accounts to receive v2. Existing accounts are never
# reclassified when these values change.
ACCOUNT_TYPE_ONBOARDING_ENABLED="false"
ACCOUNT_TYPE_ONBOARDING_ACTIVATION_AT="2026-08-10T00:00:00.000Z"

# ==============================================================================
# Multimedia (MM) Quotas and Provider Configuration
# ==============================================================================
MM_MAX_VIDEO_MINUTES="60"
MM_MAX_UPLOAD_MB="500"
MM_DAILY_ANALYSIS_LIMIT="25"
MM_MONTHLY_COST_LIMIT_USD="50"
MM_EVIDENCE_RETENTION_DAYS="90"

MM_PROVIDER_VIDEO_INTELLIGENCE="stub"
MM_PROVIDER_SPEECH_TO_TEXT="stub"
MM_PROVIDER_VISION="stub"
MM_PROVIDER_TRANSLATION="stub"
MM_PROVIDER_FACT_CHECK="stub"

# ── Web-Scan discovery providers (router falls back in this order) ──
# Firecrawl is optional now; configure at least one secondary provider so a
# Firecrawl outage (402 credits / 429 rate limit) cannot zero out web discovery.
SERPAPI_API_KEY=""
BRAVE_API_KEY=""
# Comma-separated provider ids to force-disable: firecrawl,serpapi,brave
SCAN_DISABLE_PROVIDERS=""
